# Selenium hub URL — only needed for the Supreme Court (its site sits behind an
# F5 WAF that we solve once with a headless browser). Docker sets this for you.
SELENIUM_HUB=http://localhost:4444/wd/hub

# Where the HTTP API stores its response cache. Defaults to the system temp dir.
CACHE_DIR=

# How long (seconds) to cache a fetched cause list. Default 1800 (30 minutes).
CACHE_TTL=1800
